# Server Configuration
PORT=5000
BASE_URL=https://your-ngrok-url.ngrok.io

# WAPI Credentials (https://wapi.chat)
WAPI_API_KEY=your_wapi_api_key
WAPI_INSTANCE_ID=your_instance_id
WAPI_WEBHOOK_SECRET=your_webhook_secret

# Groq Cloud API Key (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key

# MongoDB Atlas Connection URI (https://cloud.mongodb.com)
MONGODB_URI=mongodb+srv://username:password@cluster0.xxx.mongodb.net/car_wash_db?retryWrites=true&w=majority
