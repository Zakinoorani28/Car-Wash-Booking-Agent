# Whapi.Cloud Credentials (https://whapi.cloud)
WHAPI_API_TOKEN=your_whapi_channel_token
WHAPI_API_URL=https://gate.whapi.cloud
WHAPI_WEBHOOK_SECRET=your_webhook_secret_token

# VAPI.ai Credentials (https://vapi.ai)
VAPI_API_KEY=your_vapi_api_key
VAPI_ASSISTANT_ID=your_assistant_id
VAPI_PHONE_NUMBER_ID=your_phone_number_id
VAPI_WEBHOOK_SECRET=your_vapi_webhook_secret

# Groq Cloud API Key (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key

# MongoDB Atlas Connection URI (https://cloud.mongodb.com)
MONGODB_URI=mongodb+srv://username:password@cluster0.xxx.mongodb.net/car_wash_db?retryWrites=true&w=majority

# Server Configuration
PORT=5000
BASE_URL=https://your-ngrok-url.ngrok.io
